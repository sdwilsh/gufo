# Ling-3.0-flash long-context measurement image (128k/190k/254k, default and 24 GiB
# expanded-K/V budgets). Same ROCm user space as Containerfile.int; no tests, no oracles.
# Context = build/ling-long-image-ctx (see build-long-image.sh).
FROM registry.fedoraproject.org/fedora:44
RUN dnf -y install --setopt=install_weak_deps=False \
      python3 libicu libcurl libpng libjpeg-turbo libwebp libgomp openssl-libs \
      libatomic elfutils-libs numactl-libs libdrm \
      rocm-hip rocm-runtime hipblas hipblaslt rocblas rocsolver \
  && dnf clean all && rm -rf /var/cache/* /usr/share/doc /usr/share/man \
  && find /usr/lib64/rocblas/library /usr/lib64/hipblaslt/library -type f -name '*gfx[0-9]*' ! -name '*gfx1151*' -delete
COPY gufo ling-int-bench /usr/local/bin/
RUN chmod a+rx /usr/local/bin/* && mkdir -p /work && chmod 1777 /work
USER 1000:1000
WORKDIR /work
ENV HOME=/work XDG_CACHE_HOME=/work/cache TMPDIR=/work/tmp PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 PATH=/usr/local/bin:/usr/bin:/bin
ARG IMAGE=localhost/gufo:ling-int2-long
ENV GUFO_IMAGE=${IMAGE}
# stdout: one JSON line per stage; progress on stderr. Needs /work writable (4Gi emptyDir).
CMD ["ling-int-bench", "--stages", "env,long,long24"]
