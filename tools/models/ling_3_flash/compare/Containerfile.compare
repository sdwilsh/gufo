# Comparison image: the gufo release build, the 75-case eval set, and
# tools/models/ling_3_flash/compare.  One model per pod: `ling-compare --model X`.
FROM registry.fedoraproject.org/fedora:44
RUN dnf -y install --setopt=install_weak_deps=False \
      python3 python3-openai python3-httpx python3-jsonschema python3-pydantic libicu libcurl libpng libjpeg-turbo libwebp libgomp openssl-libs \
      libatomic elfutils-libs numactl-libs libdrm \
      rocm-hip rocm-runtime hipblas hipblaslt rocblas rocsolver \
  && dnf clean all && rm -rf /var/cache/* /usr/share/doc /usr/share/man \
  && find /usr/lib64/rocblas/library /usr/lib64/hipblaslt/library -type f -name '*gfx[0-9]*' ! -name '*gfx1151*' -delete
COPY gufo /usr/local/bin/gufo
COPY antirez-ds4.json /usr/local/share/gufo/eval/antirez-ds4.json
COPY compare/ /opt/gufo/compare/
COPY ling-compare /usr/local/bin/ling-compare
RUN chmod a+rx /usr/local/bin/gufo /usr/local/bin/ling-compare \
  && chmod -R a+rX /opt/gufo /usr/local/share/gufo && mkdir -p /work && chmod 1777 /work
# Restricted PSS: uid 1000, read-only root filesystem, and /work is the only writable path.
USER 1000:1000
WORKDIR /work
ENV HOME=/work XDG_CACHE_HOME=/work/cache TMPDIR=/work/tmp PYTHONDONTWRITEBYTECODE=1 \
    PATH=/usr/local/bin:/usr/bin:/bin
ARG IMAGE=localhost/gufo:ling-compare
ENV GUFO_IMAGE=${IMAGE}
CMD ["ling-compare", "--help"]
