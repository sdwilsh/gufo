#!/bin/sh
# Entry point of the comparison image.  Creates the writable directories first
# (restricted pods have only /work), then runs the harness.  Stdout is one JSON summary.
mkdir -p "${TMPDIR:-/work/tmp}" "${XDG_CACHE_HOME:-/work/cache}" 2>/dev/null
exec python3 /opt/gufo/compare/compare.py "$@"
