#!/usr/bin/env python3
"""Stand-in for `gufo serve llm` (and a llama-server-shaped /health) used to
dry-run model-bench without a GPU or model.

usage: stub-gufo serve --port P ...   (all other arguments are ignored)
       stub-gufo diagnose ...        (prints a fake fingerprint)

Serves GET /ready, /health, /v1/models and a streaming POST
/v1/chat/completions. prompt tokens = request words * 1.3 (+8 template
overhead), the reply is `max_tokens` words, and the usage block carries both
the gufo metrics and llama-style timings so either endpoint profile parses.
Deterministic: the completion text depends only on the request, so repeated
requests hash equal.
"""
import hashlib
import http.server
import json
import sys
import time


def tokens_of(messages):
    words = sum(len(str(m.get("content", "")).split()) for m in messages)
    return int(words * 1.3) + 8


SEEN = set()  # prompts already prefilled: a repeat reuses all but the last token


class Handler(http.server.BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"

    def log_message(self, *args):
        pass

    def _json(self, body, code=200):
        data = json.dumps(body).encode()
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)

    def do_GET(self):
        if self.path in ("/ready", "/health"):
            self._json({"status": "ok"})
        elif self.path.startswith("/v1/models"):
            self._json({"object": "list", "data": [{"id": "stub"}]})
        else:
            self._json({"error": "not found"}, 404)

    def do_POST(self):
        body = json.loads(self.rfile.read(int(self.headers["Content-Length"])))
        messages = body.get("messages", [])
        n_prompt = tokens_of(messages)
        n_out = int(body.get("max_tokens", 16))
        seed = hashlib.sha256(json.dumps(messages, sort_keys=True).encode()).hexdigest()
        self.send_response(200)
        self.send_header("Content-Type", "text/event-stream")
        self.send_header("Transfer-Encoding", "chunked")
        self.end_headers()

        def send(obj):
            payload = ("data: " + (obj if isinstance(obj, str) else json.dumps(obj)) + "\n\n").encode()
            self.wfile.write(f"{len(payload):x}\r\n".encode() + payload + b"\r\n")
            self.wfile.flush()

        key = hashlib.sha256(json.dumps(messages, sort_keys=True).encode()).hexdigest()
        cached = n_prompt - 1 if key in SEEN else 0
        SEEN.add(key)
        n_fill = n_prompt - cached
        prefill_ms = n_fill / 800.0 * 1000.0
        for i in range(n_out):
            send({"choices": [{"index": 0, "delta": {"content": f"w{seed[i % 60:i % 60 + 3]} "}}]})
            time.sleep(0.0005)
        decode_ms = n_out / 35.0 * 1000.0
        send({"choices": [{"index": 0, "delta": {}, "finish_reason": "length"}],
              "usage": {"prompt_tokens": n_prompt, "completion_tokens": n_out,
                        "prompt_tokens_details": {"cached_tokens": cached},
                        "gufo": {"prefill_tokens": n_fill, "queue_ms": 0.0, "prefill_ms": prefill_ms,
                                 "decode_ms": decode_ms, "ttft_ms": prefill_ms,
                                 "mean_inter_token_ms": 1000 / 35.0, "max_inter_token_ms": 1000 / 35.0,
                                 "requested_logical_concurrency": 1, "physical_execution_width": 1,
                                 "execution_plan": "stub", "cache_hit": cached > 0}},
              "timings": {"prompt_n": n_fill, "cache_n": cached, "prompt_ms": prefill_ms,
                          "predicted_n": n_out, "predicted_ms": decode_ms}})
        send("[DONE]")
        self.wfile.write(b"0\r\n\r\n")


def main(argv):
    if len(argv) > 1 and argv[1] == "diagnose":
        print(json.dumps({"stub": True, "gpu": "none", "gfx": "none", "fingerprintId": "0" * 64,
                          "canonical": {"stub": True}}))
        return 0
    if len(argv) < 2 or argv[1] != "serve" or "--port" not in argv:
        print(__doc__, file=sys.stderr)
        return 2
    port = int(argv[argv.index("--port") + 1])
    http.server.ThreadingHTTPServer(("127.0.0.1", port), Handler).serve_forever()
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
