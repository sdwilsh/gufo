#!/usr/bin/python3
"""Ling-3.0-flash batching M1 validation on gfx1151 (artifacts BATCHING-DESIGN.md
section 5, M1/M6). One JSON object per line on stdout; progress on stderr
([m1]). Writes only under --work (default $HOME = /work).

usage: ling-batch-m1 [--stages tests,serve] [--model PATH] [--work DIR]
                     [--depths 0,65536] [--concurrency 1,2,4,8] [--modes off,mtp]
                     [--rounds 2] [--tokens 128] [--c1-passes 2] [--test-args ARGS]

Stages:
  tests  full-model correctness, candidate build:
         ling_3_flash_batch_test (store, --expanded-kv-bytes 0, --mtp): every
           lane of a batched step byte-identical to the same session alone;
         ling_3_flash_batch_segments_test (and --mtp): 1..8-token segments of
           mixed widths vs Forward of the same chunks alone;
         ling_3_flash_decode_digest (--graph-compare, --mtp --graph-compare,
           and the 24,570-token long form) for the candidate and the parent
           (base build): the C1 "digests" must be identical, batch_vs_solo_differ 0;
         session_test, snapshot_test, interleave_test, restore_tail_test,
           mtp_test (unchanged contracts on the changed solo forward code).
  serve  tests/functional/run.py --suite batch --suite cache-concurrency against
         `gufo serve llm --sessions 4 --speculative off` (batch: four
         concurrent rows reach physical width 4 and replay identically), then
         --suite cache-concurrency --suite stream-start with --speculative mtp,
         then tests/functional/device_loss.py (injected HIP errors, each case
         restarting a two-session --speculative off server).
  c1     gufo bench -p 2048 -n 128 -d DEPTHS -r 3 for the parent and the
         candidate alternately (P C P C), --speculative off, and with
         --speculative mtp on the real-text corpus: per (mode, depth, phase)
         median ms of each binary and the candidate - parent delta, flagged when
         it exceeds both 5 % and 3 ms (AGENTS.md). Every repetition is kept;
         a flag prints them and fails the run.
  agg    aggregate decode over HTTP, parent and candidate servers (--sessions
         8), each mode in --modes: per depth, 8 distinct real-text prompts are
         cached once (max_tokens 1); each prompt then runs alone --rounds
         times (the C=1 reference text and per-request serve timings, compared
         per request and phase between the binaries, 5 % / 3 ms), then for
         each concurrency C, --rounds rounds of C simultaneous streamed chat
         completions (greedy, thinking off, at most --tokens tokens; chat
         usage carries the plan). Per round: the all-decoding window
         aggregate (chunks streamed while every request decodes / window),
         the wall aggregate, the summed per-request decode rates, each
         request's plan/width, and whether every text equals the same
         prompt's C=1 text. A false texts_equal_c1, an error or a timing flag
         fails the run.
"""
import argparse, http.client, json, os, signal, statistics, subprocess, sys, threading, time

HOME = os.environ.get("HOME", "/work")
TESTS = os.environ.get("M1_TESTS", "/opt/gufo/tests")
BASE = os.environ.get("M1_BASE", "/opt/gufo/base")
FUNCTIONAL = os.environ.get("M1_FUNCTIONAL", "/opt/gufo/tests/functional")
CORPUS = os.environ.get("M1_CORPUS", "/opt/gufo/corpus/corpus.txt")
GUFO = os.environ.get("M1_GUFO", "/usr/local/bin/gufo")
PARENT_GUFO = os.path.join(BASE, "gufo-parent")
FAULT_LIB = os.environ.get("M1_FAULT_LIB", "/opt/gufo/lib/libdevice_loss_faults.so")


def log(msg):
    print("[m1] " + msg, file=sys.stderr, flush=True)


def emit(obj):
    print(json.dumps(obj, sort_keys=True), flush=True)


def tail(path, n=3000):
    try:
        with open(path, "rb") as f:
            f.seek(0, 2)
            f.seek(max(0, f.tell() - n))
            return f.read().decode("utf-8", "replace")
    except OSError:
        return ""


def run(cmd, work, name, timeout):
    out, err = os.path.join(work, name + ".out"), os.path.join(work, name + ".err")
    log("run %s: %s" % (name, " ".join(cmd)))
    t0 = time.monotonic()
    with open(out, "wb") as o, open(err, "wb") as e:
        p = subprocess.Popen(cmd, stdout=o, stderr=e, start_new_session=True)
        try:
            code = p.wait(timeout=timeout)
        except subprocess.TimeoutExpired:
            os.killpg(p.pid, signal.SIGKILL)
            p.wait()
            code = "timeout"
    return code, round(time.monotonic() - t0, 1), out, err


def last_json(path):
    text = open(path, "rb").read().decode("utf-8", "replace")
    for line in reversed(text.splitlines()):
        line = line.strip()
        if line.startswith("{"):
            try:
                return json.loads(line)
            except ValueError:
                pass
    return None


# ---- tests ------------------------------------------------------------------

def stage_tests(a, work):
    M = a.model
    t = lambda n: os.path.join(TESTS, "ling_3_flash_" + n)
    rows, ok = [], True

    def tool(name, cmd, timeout=3600):
        nonlocal ok
        code, secs, out, err = run(cmd + a.test_args.split(), work, name, timeout)
        doc = last_json(out) or {}
        row = {"name": name, "exit_code": code, "seconds": secs, "status": doc.get("status")}
        failed = [c.get("name") for c in doc.get("checks", []) if not c.get("pass", True)]
        if failed:
            row["failed_checks"] = failed
        if code != 0:
            row["stderr_tail"] = tail(err)
            ok = False
        rows.append(row)
        log("%s: exit %s in %ss" % (name, code, secs))
        return doc

    tool("batch_test", [t("batch_test"), "--model", M])
    tool("batch_test_no_store", [t("batch_test"), "--model", M, "--expanded-kv-bytes", "0"])
    tool("batch_test_mtp", [t("batch_test"), "--model", M, "--mtp"])
    tool("batch_segments_test", [t("batch_segments_test"), "--model", M])
    tool("batch_segments_test_mtp", [t("batch_segments_test"), "--model", M, "--mtp"])
    digests = []
    for label, extra in (("default", ["--graph-compare"]),
                         ("mtp", ["--mtp", "--graph-compare"]),
                         ("long", ["--graph-compare", "--layers", "8", "--max-batch", "512",
                                   "--max-context", "25000", "--prompt-tokens", "24570",
                                   "--decode-tokens", "12"])):
        cand = tool("decode_digest_" + label, [t("decode_digest"), "--model", M] + extra)
        par = tool("decode_digest_parent_" + label,
                   [os.path.join(BASE, "ling_3_flash_decode_digest-parent"), "--model", M] + extra)
        same = bool(cand.get("digests")) and cand.get("digests") == par.get("digests")
        row = {"case": label, "c1_digests_equal_parent": same,
               "candidate_pass": cand.get("pass"), "parent_pass": par.get("pass"),
               "batch_vs_solo_differ": cand.get("batch_vs_solo_differ"),
               "batch_digests": len(cand.get("batch_digests", [])),
               "graph_vs_eager_differ": cand.get("graph_vs_eager_differ")}
        if not (same and cand.get("pass") and cand.get("batch_vs_solo_differ") == 0):
            ok = False
        digests.append(row)
    tool("session_test", [t("session_test"), "--model", M])
    tool("snapshot_test", [t("snapshot_test"), "--model", M])
    tool("snapshot_test_block_edge", [t("snapshot_test"), "--model", M, "--prompt-tokens", "2300",
                                      "--max-context", "4096"])
    tool("interleave_test", [t("interleave_test"), "--model", M])
    tool("restore_tail_test", [t("restore_tail_test"), "--model", M])
    tool("mtp_test", [t("mtp_test"), "--model", M])
    emit({"stage": "tests", "pass": ok, "tools": rows, "decode_digest": digests})
    return ok


# ---- serve ------------------------------------------------------------------

def stage_serve(a, work):
    ok, rows = True, []
    for mode, suites, sessions in (("off", ["batch", "cache-concurrency"], 4),
                                   ("mtp", ["cache-concurrency", "stream-start"], 4)):
        # run.py creates its output directory and refuses an existing one.
        d = os.path.join(work, "functional-" + mode)
        cmd = [sys.executable, FUNCTIONAL + "/run.py", "--record-baseline", "--sampling-preset", "ling3"]
        for s in suites:
            cmd += ["--suite", s]
        cmd += ["--output", d, "--", GUFO, "serve", "llm", "--model", a.model, "--context", "16384",
                "--sessions", str(sessions), "--log-level", "debug", "--speculative", mode]
        code, secs, out, err = run(cmd, work, "functional-" + mode, 5400)
        row = {"mode": mode, "suites": suites, "exit_code": code, "seconds": secs}
        try:
            rep = json.load(open(os.path.join(d, "report.json")))
            row["report_status"] = rep.get("status")
            row["suite_status"] = {n: r.get("status") for n, r in rep.get("suites", {}).items()}
            # Execution plans of the batch suite's concurrent rows.
            checks = json.dumps(rep)
            row["batched_labels"] = sorted(set(
                w for w in ("batched-w2", "batched-w3", "batched-w4") if w in checks))
        except (OSError, ValueError) as e:
            row["report_error"] = str(e)
        if code != 0:
            ok = False
            row["stdout_tail"], row["stderr_tail"] = tail(out), tail(err)
        rows.append(row)
    # Injected HIP errors (device_loss.py, ws23): every case restarts the
    # server; with two sessions and --speculative off the decode runs batched.
    d = os.path.join(work, "device-loss")
    cmd = [sys.executable, FUNCTIONAL + "/device_loss.py", "--fault-library", FAULT_LIB,
           "--output", d, "--startup-timeout", "1800", "--request-timeout", "120",
           "--case-timeout", "2400", "--", GUFO, "serve", "llm", "--model", a.model,
           "--sessions", "2", "--context", "4096", "--think", "off", "--speculative", "off"]
    code, secs, out, err = run(cmd, work, "device-loss", 6 * 3600)
    row = {"mode": "off", "suites": ["device_loss"], "exit_code": code, "seconds": secs}
    try:
        rep = json.load(open(os.path.join(d, "report.json")))
        row["cases"] = {c["case"]: c["status"] for c in rep["cases"]}
    except (OSError, ValueError, KeyError) as e:
        row["report_error"] = str(e)
    if code != 0:
        ok = False
        row["stdout_tail"], row["stderr_tail"] = tail(out), tail(err)
    rows.append(row)
    emit({"stage": "serve", "pass": ok, "runs": rows})
    return ok


# ---- c1 (gufo bench) ----------------------------------------------------------

def bench_samples(path):
    """(depth, phase) -> list of ms for the phase (prefill of n_prompt or decode
    of n_gen tokens), from gufo bench jsonl (llama-bench layout)."""
    out = {}
    for line in open(path, encoding="utf-8", errors="replace"):
        line = line.strip()
        if not line.startswith("{"):
            continue
        try:
            r = json.loads(line)
        except ValueError:
            continue
        if r.get("record") != "result" or not r.get("samples_ns"):
            continue
        n_p, n_g, depth = r.get("n_prompt", 0), r.get("n_gen", 0), r.get("n_depth", 0)
        phase = "prefill%d" % n_p if n_p else "decode%d" % n_g
        out.setdefault("%s@%s" % (phase, depth), []).extend(ns / 1e6 for ns in r["samples_ns"])
    return out


def flag(parent, candidate):
    """5 % / 3 ms rule (AGENTS.md) on the medians of one phase's repetitions."""
    p, c = statistics.median(parent), statistics.median(candidate)
    return c - p > max(0.05 * p, 3.0), round(p, 3), round(c, 3)


def stage_c1(a, work):
    """Per (mode, phase, depth): every repetition of every pass of each binary,
    passes alternating parent/candidate; flagged when the candidate median
    exceeds the parent's by more than 5 % and 3 ms. Flags fail the run."""
    rows, ok = [], True
    for mode in a.modes.split(","):
        runs = {"parent": {}, "candidate": {}}  # key -> [per-pass rep lists]
        for p in range(a.c1_passes):
            for who, binary in (("parent", PARENT_GUFO), ("candidate", GUFO)):
                name = "c1-%s-%s-%d" % (mode, who, p)
                cmd = [binary, "bench", "-m", a.model, "-p", "2048", "-n", "128", "-d", a.depths,
                       "-r", "3", "-o", "jsonl", "--speculative", mode]
                if mode == "mtp":
                    cmd += ["--text-file", CORPUS]
                code, secs, out, err = run(cmd, work, name, 5400)
                if code != 0:
                    ok = False
                    rows.append({"mode": mode, "binary": who, "pass_index": p, "exit_code": code,
                                 "stderr_tail": tail(err)})
                    continue
                for key, ms in bench_samples(out).items():
                    runs[who].setdefault(key, []).append([round(x, 3) for x in ms])
        for key in sorted(set(runs["parent"]) | set(runs["candidate"])):
            pr, cr = runs["parent"].get(key, []), runs["candidate"].get(key, [])
            pm, cm = [x for r in pr for x in r], [x for r in cr for x in r]
            if not pm or not cm:
                ok = False
                rows.append({"mode": mode, "phase_depth": key, "error": "missing samples"})
                continue
            flagged, p_med, c_med = flag(pm, cm)
            ok = ok and not flagged
            rows.append({"mode": mode, "phase_depth": key, "parent_median_ms": p_med,
                         "candidate_median_ms": c_med, "delta_ms": round(c_med - p_med, 3),
                         "ratio": round(c_med / p_med, 4), "regression_flag": flagged,
                         "parent_reps_ms": pr, "candidate_reps_ms": cr})
    flags = [r for r in rows if r.get("regression_flag")]
    for r in flags:
        log("C1 FLAG %s %s: parent %s candidate %s" % (
            r["mode"], r["phase_depth"], r["parent_reps_ms"], r["candidate_reps_ms"]))
    emit({"stage": "c1", "pass": ok, "rows": rows, "flags": flags})
    return ok


# ---- agg (HTTP) ---------------------------------------------------------------

class Server:
    def __init__(self, binary, a, mode, port, work, name):
        self.cmd = [binary, "serve", "llm", "--model", a.model, "--sessions", "8",
                    "--context", str(max(int(d) for d in a.depths.split(",")) + 4096),
                    "--speculative", mode, "--host", "127.0.0.1", "--port", str(port),
                    "--served-model-name", "m1", "--max-pending-per-client", "16",
                    "--log-level", "info"]
        self.port, self.log = port, os.path.join(work, name + ".log")

    def __enter__(self):
        log("server: " + " ".join(self.cmd))
        self.f = open(self.log, "wb")
        self.p = subprocess.Popen(self.cmd, stdout=self.f, stderr=subprocess.STDOUT,
                                  start_new_session=True)
        deadline = time.monotonic() + 1800
        while time.monotonic() < deadline:
            if self.p.poll() is not None:
                raise RuntimeError("server exited %s: %s" % (self.p.returncode, tail(self.log)))
            try:
                c = http.client.HTTPConnection("127.0.0.1", self.port, timeout=2)
                c.request("GET", "/health")
                if c.getresponse().status == 200:
                    return self
            except (OSError, http.client.HTTPException):
                pass
            time.sleep(1)
        raise TimeoutError("server startup")

    def __exit__(self, *exc):
        if self.p.poll() is None:
            self.p.send_signal(signal.SIGINT)
            try:
                self.p.wait(timeout=120)
            except subprocess.TimeoutExpired:
                self.p.kill()
                self.p.wait()
        self.f.close()
        return False


def chat(port, prompt, max_tokens, stream=True, cache=True):
    """One greedy chat completion (thinking off; chat usage carries the
    usage.gufo plan and stage metrics, raw completions do not). Returns text,
    usage, start, per-chunk times, end."""
    body = {"model": "m1", "messages": [{"role": "user", "content": prompt}],
            "max_tokens": max_tokens, "temperature": 0, "reasoning_effort": "none",
            "cache_prompt": cache, "stream": stream}
    if stream:
        body["stream_options"] = {"include_usage": True}
    c = http.client.HTTPConnection("127.0.0.1", port, timeout=3600)
    start = time.monotonic()
    c.request("POST", "/v1/chat/completions", json.dumps(body),
              {"Content-Type": "application/json"})
    r = c.getresponse()
    if r.status != 200:
        raise RuntimeError("HTTP %s: %s" % (r.status, r.read()[:400]))
    if not stream:
        doc = json.loads(r.read())
        msg = doc["choices"][0].get("message", {})
        return ((msg.get("reasoning_content") or "") + (msg.get("content") or ""),
                doc.get("usage", {}), start, [], time.monotonic())
    parts, times, usage = [], [], {}
    while True:
        line = r.readline()
        if not line:
            break
        line = line.strip()
        if not line.startswith(b"data:"):
            continue
        data = line[5:].strip()
        if data == b"[DONE]":
            break
        chunk = json.loads(data)
        if "error" in chunk:
            raise RuntimeError("stream error: %s" % json.dumps(chunk["error"]))
        for ch in chunk.get("choices") or []:
            delta = ch.get("delta") or {}
            piece = (delta.get("reasoning_content") or "") + (delta.get("content") or "")
            if piece:
                parts.append(piece)
                times.append(time.monotonic())
        if isinstance(chunk.get("usage"), dict):
            usage = chunk["usage"]
    return "".join(parts), usage, start, times, time.monotonic()


def prompts_for(port, depth, count):
    """`count` distinct real-text prompts of about `depth` tokens (at least 160,
    above the runner's 128-token snapshot floor, so every prompt is cached). The
    chars-per-token ratio of each corpus region is measured with an uncached
    4,000-character probe; a prompt the server refuses as too long shrinks."""
    text = open(CORPUS, encoding="utf-8", errors="replace").read()
    target = max(160, depth)
    stride = max(1, (len(text) - 1) // count)
    out = []
    for i in range(count):
        start = i * stride
        head = "Document %d.\n" % i
        probe = text[start:start + 4000]
        usage = chat(port, head + probe, 1, stream=False, cache=False)[1]
        ratio = len(probe) / max(1, usage.get("prompt_tokens", 1000))
        chars = int(target * ratio * 0.97)
        out.append((head, start, chars))
    return text, out


def prompt_text(text, spec):
    head, start, chars = spec
    return head + text[start:start + chars] + "\n\nSummarise this document."


def round_metrics(results, tokens):
    firsts = [r[3][0] for r in results if r[3]]
    lasts = [r[3][-1] for r in results if r[3]]
    lo, hi = (max(firsts), min(lasts)) if firsts else (0, 0)
    inside = sum(sum(1 for t in r[3] if lo <= t <= hi) for r in results)
    total = sum(int(r[1].get("completion_tokens", 0)) for r in results)
    span = max(r[4] for r in results) - min(r[2] for r in results)
    g = [r[1].get("gufo", {}) for r in results]
    summed = sum((int(r[1].get("completion_tokens", 0)) - 1) / (x.get("decode_ms", 0) / 1000.0)
                 for r, x in zip(results, g) if x.get("decode_ms"))
    return {
        "window_s": round(hi - lo, 3),
        "agg_window_tps": round(inside / (hi - lo), 2) if hi > lo else None,
        "agg_wall_tps": round(total / span, 2) if span > 0 else None,
        "summed_rate_tps": round(summed, 2),
        "per_request": [{"plan": x.get("execution_plan"), "width": x.get("physical_execution_width"),
                         "prompt_tokens": r[1].get("prompt_tokens"),
                         "cached_tokens": (r[1].get("prompt_tokens_details") or {}).get("cached_tokens"),
                         "completion_tokens": r[1].get("completion_tokens"),
                         "prefill_ms": x.get("prefill_ms"), "decode_ms": x.get("decode_ms"),
                         "ttft_ms": x.get("ttft_ms"), "draft_tokens": x.get("draft_tokens")}
                        for r, x in zip(results, g)],
    }


def stage_agg(a, work):
    """Aggregate decode per (mode, binary, depth, C, round), plus the C=1 serve
    timings of every prompt (each alone, --rounds repetitions), compared per
    request and phase between the binaries (5 % / 3 ms on the medians of its
    repetitions). Fails on any texts_equal_c1 false, server error or flag."""
    levels = [int(c) for c in a.concurrency.split(",")]
    port, ok = 18480, True
    c1 = {}  # (mode, depth, prompt) -> binary -> {phase: [ms per repetition]}
    for mode in a.modes.split(","):
        for who, binary in (("parent", PARENT_GUFO), ("candidate", GUFO)):
            port += 1
            name = "agg-%s-%s" % (mode, who)
            try:
                with Server(binary, a, mode, port, work, name):
                    for depth in [int(d) for d in a.depths.split(",")]:
                        text, specs = prompts_for(port, depth, max(levels))
                        prompts = []
                        t0 = time.monotonic()
                        for spec in specs:  # cache every prompt once
                            for _ in range(4):
                                try:
                                    p = prompt_text(text, spec)
                                    chat(port, p, 1, stream=False)
                                    break
                                except RuntimeError as e:  # too long: shrink 10 %
                                    if "HTTP 4" not in str(e):
                                        raise
                                    spec = (spec[0], spec[1], int(spec[2] * 0.9))
                            prompts.append(p)
                        warm_s = round(time.monotonic() - t0, 1)
                        # C=1: every prompt alone; the reference texts and the
                        # per-request serve timings.
                        reference = []
                        for rep in range(a.rounds):
                            for i, p in enumerate(prompts):
                                r = chat(port, p, a.tokens)
                                g = r[1].get("gufo", {})
                                if rep == 0:
                                    reference.append(r[0])
                                elif r[0] != reference[i]:
                                    ok = False
                                    log("C1 repeat differs: %s %s d%d prompt %d" % (mode, who, depth, i))
                                phases = c1.setdefault((mode, depth, i), {}).setdefault(who, {})
                                for ph in ("prefill_ms", "decode_ms", "ttft_ms"):
                                    phases.setdefault(ph, []).append(g.get(ph))
                                phases.setdefault("completion_tokens", []).append(
                                    r[1].get("completion_tokens"))
                        for c in levels:
                            for rnd in range(a.rounds):
                                results = [None] * c
                                go = threading.Barrier(c)

                                def user(i):
                                    go.wait()
                                    results[i] = chat(port, prompts[i], a.tokens)
                                threads = [threading.Thread(target=user, args=(i,)) for i in range(c)]
                                for th in threads:
                                    th.start()
                                for th in threads:
                                    th.join()
                                if any(r is None for r in results):
                                    raise RuntimeError("a concurrent request failed")
                                same = all(r[0] == reference[i] for i, r in enumerate(results))
                                ok = ok and same
                                row = {"stage": "agg", "mode": mode, "binary": who, "depth": depth,
                                       "concurrency": c, "round": rnd, "warm_s": warm_s,
                                       "texts_equal_c1": same}
                                row.update(round_metrics(results, a.tokens))
                                emit(row)
                                log("%s %s d%d C%d r%d: window %s t/s, wall %s t/s, same %s" % (
                                    mode, who, depth, c, rnd, row["agg_window_tps"],
                                    row["agg_wall_tps"], same))
            except Exception as e:  # keep going with the other server
                ok = False
                emit({"stage": "agg", "mode": mode, "binary": who, "error": str(e),
                      "log_tail": tail(os.path.join(work, name + ".log"))})
    rows = []
    for (mode, depth, i), by in sorted(c1.items()):
        if "parent" not in by or "candidate" not in by:
            continue
        for ph in ("prefill_ms", "decode_ms", "ttft_ms"):
            pr = [x for x in by["parent"][ph] if x is not None]
            cr = [x for x in by["candidate"][ph] if x is not None]
            if not pr or not cr:
                continue
            flagged, p_med, c_med = flag(pr, cr)
            ok = ok and not flagged
            rows.append({"mode": mode, "depth": depth, "prompt": i, "phase": ph,
                         "parent_reps_ms": pr, "candidate_reps_ms": cr,
                         "parent_median_ms": p_med, "candidate_median_ms": c_med,
                         "completion_tokens": [by["parent"]["completion_tokens"],
                                               by["candidate"]["completion_tokens"]],
                         "regression_flag": flagged})
    flags = [r for r in rows if r["regression_flag"]]
    for r in flags:
        log("C1 serve FLAG %s d%d prompt %d %s: parent %s candidate %s" % (
            r["mode"], r["depth"], r["prompt"], r["phase"], r["parent_reps_ms"],
            r["candidate_reps_ms"]))
    emit({"stage": "agg_c1_serve", "pass": ok, "rows": rows, "flags": flags})
    return ok


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--stages", default="tests,serve")
    ap.add_argument("--model", default=os.environ.get(
        "MODEL", "/models/Ling-3.0-flash-AD-Q4_K_S-00001-of-00002.gguf"))
    ap.add_argument("--work", default=HOME)
    ap.add_argument("--depths", default="0,65536")
    ap.add_argument("--concurrency", default="1,2,4,8")
    ap.add_argument("--modes", default="off,mtp")
    ap.add_argument("--rounds", type=int, default=2)
    ap.add_argument("--tokens", type=int, default=128)
    ap.add_argument("--c1-passes", type=int, default=2)
    ap.add_argument("--test-args", default="",
                    help="appended to every test binary (local smoke: --layers 12)")
    a = ap.parse_args()
    work = os.path.join(a.work, "m1")
    os.makedirs(work, exist_ok=True)
    os.makedirs(os.environ.get("TMPDIR", os.path.join(a.work, "tmp")), exist_ok=True)
    emit({"stage": "env", "image": os.environ.get("GUFO_IMAGE"), "model": a.model,
          "node": os.uname().nodename, "stages": a.stages,
          "diagnose": subprocess.run([GUFO, "diagnose"], capture_output=True, text=True,
                                     timeout=300).stdout[-4000:]})
    ok = True
    for s in a.stages.split(","):
        fn = {"tests": stage_tests, "serve": stage_serve, "c1": stage_c1, "agg": stage_agg}[s]
        log("stage " + s)
        ok = fn(a, work) and ok
    emit({"stage": "done", "pass": ok})
    return 0 if ok else 1


if __name__ == "__main__":
    sys.exit(main())
